# Public URL where the app is served. Used in canonical tags, OG/Twitter image
# URLs, JSON-LD, sitemap.xml and robots.txt at build time. No trailing slash.
VITE_PUBLIC_URL=https://your-domain.example

# Endpoint used by the in-app Share dialog. Default: /api (same origin).
# Set to an absolute URL when the share API is hosted elsewhere
# (e.g. https://jsonos-share.<sub>.workers.dev/api).
# VITE_SHARE_API=/api
